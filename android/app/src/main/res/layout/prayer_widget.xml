<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirrors the in-app "next prayer" hero: mint eyebrow, large prayer name,
  a progress bar across the window between prayers, and a quiet footer.
  Rows below the countdown hide themselves on small widgets - see
  PrayerWidgetProvider.applySize.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/prayer_widget_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Next prayer"
            android:textColor="#23C486" android:textSize="11sp" android:textStyle="bold"
            android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_refresh" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_widget_refresh" android:contentDescription="Refresh"
            android:padding="1dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_prayer" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Qibla Finder"
            android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="18sp"
            android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>

    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp"
        android:max="1000" android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout android:id="@+id/widget_countdown_row" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="6dp">
        <ImageView android:layout_width="13dp" android:layout_height="13dp"
            android:src="@drawable/ic_widget_time" android:contentDescription="@null" />
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textColor="#CDEDDD" android:textSize="15sp"
            android:contentDescription="Time remaining until the next prayer" />
        <TextView android:id="@+id/widget_now" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="#CDEDDD"
            android:textSize="11sp" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_upcoming" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="8dp" android:baselineAligned="false">
        <LinearLayout android:id="@+id/widget_up1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_up1_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#8FBFA8" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_up1_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"
                android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_up2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_up2_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#8FBFA8" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_up2_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"
                android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_up3" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_up3_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#8FBFA8" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_up3_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"
                android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ImageView android:layout_width="12dp" android:layout_height="12dp"
            android:src="@drawable/ic_widget_place" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_place" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:textColor="#8FBFA8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_qibla_icon" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginStart="8dp" android:src="@drawable/ic_widget_compass"
            android:contentDescription="@null" />
        <TextView android:id="@+id/widget_qibla" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:textColor="#23C486" android:textSize="11sp"
            android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
